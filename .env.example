# Per-team salt from the team slip. Never commit the real value.
DAY1_SALT=replace-with-your-team-salt

# Optional overrides (docker-compose.yml has working defaults)
JWT_SECRET=nascon-dev-jwt-secret-change-me
PORT=8080
DATABASE_URL=postgres://nascon:nascon@postgres:5432/nascon
REDIS_URL=redis://redis:6379
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=nascon
MINIO_SECRET_KEY=nascon-secret
MINIO_BUCKET=receipts
